# Peninsula Equine Web - Environment Configuration

# ============================================
# VIDEO CDN CONFIGURATION (Recommended)
# ============================================
# Enable CDN hosting for videos (much faster than Git LFS)
# Set to 'true' to use CDN, 'false' to use local videos
VITE_VIDEO_CDN_ENABLED=false

# Base URL for your CDN (e.g., Cloudinary, Vercel Blob, etc.)
# Example Cloudinary: https://res.cloudinary.com/YOUR_CLOUD_NAME/video/upload/peninsula-equine/videos
# Example Vercel Blob: https://your-project.vercel-storage.com/videos
# Example GitHub Release: https://github.com/USER/REPO/releases/download/TAG
VITE_VIDEO_CDN_URL=

# ============================================
# INDIVIDUAL VIDEO URL OVERRIDES (Optional)
# ============================================
# You can specify individual video URLs if they're in different locations
# These override the CDN base URL for specific videos

# Hero Videos (HomePage)
# VITE_VIDEO_IMG_1351_MP4=https://your-cdn.com/path/to/IMG_1351.mp4
# VITE_VIDEO_IMG_1354_MP4=https://your-cdn.com/path/to/IMG_1354.mp4
# VITE_VIDEO_IMG_2975_MP4=https://your-cdn.com/path/to/IMG_2975.mp4

# Construction Videos (ConstructionsPage)
# VITE_VIDEO_IMG_0014_MP4=https://your-cdn.com/path/to/IMG_0014.mp4
# VITE_VIDEO_IMG_0015_MP4=https://your-cdn.com/path/to/IMG_0015.mp4
# VITE_VIDEO_IMG_1021_MP4=https://your-cdn.com/path/to/IMG_1021.mp4
# VITE_VIDEO_IMG_2461_MP4=https://your-cdn.com/path/to/IMG_2461.mp4

# ============================================
# SETUP EXAMPLES
# ============================================

# Example 1: Using Cloudinary (Recommended)
# 1. Sign up at https://cloudinary.com (free)
# 2. Upload your videos to a folder
# 3. Copy your cloud name and set:
#    VITE_VIDEO_CDN_ENABLED=true
#    VITE_VIDEO_CDN_URL=https://res.cloudinary.com/YOUR_CLOUD_NAME/video/upload/peninsula-equine/videos

# Example 2: Using Vercel Blob Storage
# 1. Install Vercel CLI: npm i -g vercel
# 2. Upload videos: vercel blob upload video.mp4
# 3. Set the URLs:
#    VITE_VIDEO_CDN_ENABLED=true
#    VITE_VIDEO_CDN_URL=https://your-blob-url.vercel-storage.com

# Example 3: Using GitHub Releases
# 1. Create a release with tag "videos-v1.0"
# 2. Attach all video files to the release
# 3. Set:
#    VITE_VIDEO_CDN_ENABLED=true
#    VITE_VIDEO_CDN_URL=https://github.com/USER/REPO/releases/download/videos-v1.0

# Example 4: Using Local Videos (Git LFS)
# 1. Place videos in src/assets/media/converted/
# 2. Set:
#    VITE_VIDEO_CDN_ENABLED=false
# Note: This requires Git LFS and is slower

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Vercel deployment:
# 1. Go to your Vercel project settings
# 2. Navigate to "Environment Variables"
# 3. Add VITE_VIDEO_CDN_ENABLED and VITE_VIDEO_CDN_URL
# 4. Redeploy your application
